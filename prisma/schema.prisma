// =============================================================================
// Custom Workspace & ERP Platform — Prisma Schema
// PostgreSQL + Prisma 6 | Multi-tenant | Granular RBAC
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum CompanyPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
  // Planner (Bitrix24) — yeni dəyərlər mövcud enum-un sonuna əlavə olunur
  NOT_PLANNED
  REVIEW
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  ASSIGN
  COMPLETE
  ARCHIVE
  RESTORE
}

enum EntityType {
  USER
  COMPANY
  DEPARTMENT
  ROLE
  PROJECT
  TASK
  COMMENT
  ATTACHMENT
  LABEL
  MARKETING_CAMPAIGN
  MARKETING_SEGMENT
  WAREHOUSE
  PRODUCT
  STOCK_MOVEMENT
  SUPPLIER
  PURCHASE_ORDER
  TEMPLATE
}

// --- CRM İNTEQRASİYA ENUM-LARI (1C / Email / Twilio / Telegram) ---

enum MessageLogType {
  EMAIL
  WHATSAPP
  TELEGRAM
  SMS
}

enum MessageLogStatus {
  SENT
  FAILED
}

// --- MARKETİNQ KAMPANİYALARI ENUM-LARI (Bitrix24 tərzi Marketing modulu) ---

enum CampaignType {
  EMAIL
  SMS
  WHATSAPP
  INSTAGRAM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// --- ANBAR İDARƏETMƏ SİSTEMİ (WMS) ENUM-LARI — Bitrix24 / Odoo / SAP tərzi ---

enum WarehouseType {
  MAIN // Əsas anbar
  TRANSIT // Tranzit (aralıq) anbar
}

enum StockMovementType {
  INBOUND // Təchizatçıdan/xaricdən daxilolma
  OUTBOUND // Müştəriyə/xaricə çıxış (satış sifarişi)
  TRANSFER // Anbarlar/hüceyrələr arası daxili köçürmə
  ADJUSTMENT // Stok tənzimləməsi (inventarlaşdırma, ilkin qalıq)
  SCRAP // Yararsız/zay silinməsi (write-off)
}

enum StockMovementStatus {
  DRAFT // Sənəd yaradılıb, qalıqlara təsir etməyib
  PENDING // Təsdiq gözləyir
  COMPLETED // İcra olunub, qalıqlar yenilənib
  CANCELLED // Ləğv edilib
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// --- ŞABLON (TEMPLATE) SİSTEMİ ENUM-U ---
// Kartlar/Tapşırıqlar üçün ayrıca `TaskTemplate` modeli mövcuddur (aşağıda).
// Bu model isə Layihə, Dəvət və Rol/İcazə şablonlarını əhatə edir.
enum TemplateType {
  PROJECT
  INVITATION
  ROLE
}

// =============================================================================
// PERMISSION KEYS — 38 Granular Permission Types
// =============================================================================
// Bu enum backend-də type safety üçün istifadə olunur.
// Həm də Permission cədvəlindəki key sütununu validate edir.

enum PermissionKey {
  // --- COMPANY MANAGEMENT ---
  CAN_MANAGE_COMPANY // Şirkət məlumatlarını redaktə edə bilər
  CAN_INVITE_USER // Şirkətə yeni istifadəçi dəvət edə bilər
  CAN_REMOVE_USER // İstifadəçini şirkətdən çıxara bilər
  CAN_VIEW_AUDIT_LOG // Audit jurnalını görə bilər
  CAN_MANAGE_BILLING // Ödəniş məlumatlarını idarə edə bilər

  // --- ROLE & PERMISSION MANAGEMENT ---
  CAN_CREATE_ROLE // Yeni rol yarada bilər
  CAN_EDIT_ROLE // Mövcud rolu redaktə edə bilər
  CAN_DELETE_ROLE // Rolu silə bilər
  CAN_ASSIGN_ROLE // İstifadəçilərə rol mənimsədə bilər
  CAN_VIEW_ROLES // Rolları görə bilər

  // --- DEPARTMENT MANAGEMENT ---
  CAN_CREATE_DEPARTMENT // Yeni şöbə yarada bilər
  CAN_EDIT_DEPARTMENT // Şöbəni redaktə edə bilər
  CAN_DELETE_DEPARTMENT // Şöbəni silə bilər
  CAN_VIEW_DEPARTMENTS // Şöbələri görə bilər
  CAN_ASSIGN_DEPARTMENT // İstifadəçiləri şöbəyə aid edə bilər

  // --- PROJECT MANAGEMENT ---
  CAN_CREATE_PROJECT // Yeni layihə yarada bilər
  CAN_EDIT_PROJECT // Layihəni redaktə edə bilər
  CAN_DELETE_PROJECT // Layihəni silə bilər
  CAN_VIEW_PROJECT // Layihəni görə bilər
  CAN_ARCHIVE_PROJECT // Layihəni arxivləşdirə bilər
  CAN_CHANGE_PROJECT_STATUS // Layihənin statusunu dəyişə bilər
  CAN_ASSIGN_PROJECT_MEMBER // Layihəyə üzv əlavə edə/çıxara bilər

  // --- TASK MANAGEMENT ---
  CAN_CREATE_TASK // Yeni tapşırıq yarada bilər
  CAN_EDIT_TASK // Tapşırığı redaktə edə bilər
  CAN_DELETE_TASK // Tapşırığı silə bilər
  CAN_VIEW_TASK // Tapşırığı görə bilər
  CAN_ASSIGN_TASK // Tapşırığa icraçı təyin edə bilər
  CAN_CHANGE_TASK_STATUS // Tapşırığın statusunu dəyişə bilər
  CAN_SET_TASK_PRIORITY // Tapşırığın prioritetini təyin edə bilər
  CAN_SET_TASK_DEADLINE // Tapşırığın son tarixini təyin edə bilər

  // --- SUBTASK MANAGEMENT ---
  CAN_CREATE_SUBTASK // Alt tapşırıq yarada bilər
  CAN_EDIT_SUBTASK // Alt tapşırığı redaktə edə bilər
  CAN_DELETE_SUBTASK // Alt tapşırığı silə bilər
  CAN_COMPLETE_SUBTASK // Alt tapşırığı tamamlaya bilər

  // --- COMMENT & COLLABORATION ---
  CAN_COMMENT // Şərh yaza bilər
  CAN_EDIT_OWN_COMMENT // Öz şərhini redaktə edə bilər
  CAN_DELETE_OWN_COMMENT // Öz şərhini silə bilər
  CAN_DELETE_ANY_COMMENT // İstənilən şərhi silə bilər (Moderator)

  // --- FILE MANAGEMENT ---
  CAN_UPLOAD_FILE // Fayl yükləyə bilər
  CAN_DELETE_OWN_FILE // Öz faylını silə bilər
  CAN_DELETE_ANY_FILE // İstənilən faylı silə bilər
  CAN_VIEW_FILES // Faylları görə bilər

  // --- REPORTING ---
  CAN_VIEW_REPORTS // Hesabatları görə bilər
  CAN_EXPORT_DATA // Məlumatları export edə bilər

  // --- MODULE ACCESS (şöbə əsaslı RBAC) ---
  CAN_MANAGE_MARKETING
  CAN_VIEW_MARKETING
  CAN_MANAGE_FINANCE
  CAN_VIEW_FINANCE
  CAN_MANAGE_WMS
  CAN_VIEW_WMS
  CAN_MANAGE_CRM
  CAN_VIEW_CRM
  CAN_MANAGE_HR
  CAN_VIEW_HR
  CAN_MANAGE_LEGAL
  CAN_VIEW_LEGAL
  CAN_MANAGE_IT
  CAN_VIEW_IT
  CAN_MANAGE_DATA
  CAN_VIEW_DATA
  CAN_MANAGE_LOGISTICS
  CAN_VIEW_LOGISTICS
  CAN_MANAGE_INTERNATIONAL
  CAN_VIEW_INTERNATIONAL
}

// Təşkilati iyerarxiya (rəng kodlaması): Müşahidə Şurası → İdarə Heyəti →
// Şöbə Müdiri → Bölmə Müdiri → Qrup rəhbəri → Mütəxəssis
enum OrgLevel {
  SUPERVISORY_BOARD
  EXECUTIVE_BOARD
  DEPARTMENT_HEAD
  SECTION_HEAD
  GROUP_LEAD
  SPECIALIST
}

// =============================================================================
// MODEL: Company (Multi-tenant anchor — hər şey buraya bağlıdır)
// =============================================================================

model Company {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique // URL-friendly unikal ad: "acme-corp"
  description String?
  logo        String? // URL
  website     String?
  taxId       String? // YENİ: VÖEN və ya Qeydiyyat Nömrəsi
  plan        CompanyPlan @default(FREE)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Yeni dəvət edilən (MEMBER tipli) istifadəçilərin default olaraq üzv ediləcəyi layihələr
  defaultProjectIds String[] @default([])

  // YENİ ƏLAVƏLƏR: Avtomatik Rollar (Member və Guest üçün)
  defaultMemberRoleId String?
  defaultGuestRoleId  String?

  // Owner — şirkəti yaradan istifadəçi (1 şirkətin 1 sahibi var)
  ownerId String @unique
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])

  // Relations
  users              User[]              @relation("CompanyUsers")
  departments        Department[]
  roles              Role[]
  projects           Project[]
  labels             Label[]
  auditLogs          AuditLog[]
  crmCompanies       CrmCompany[]
  crmContacts        CrmContact[]
  crmStages          CrmStage[]
  crmDeals           CrmDeal[]
  chatChannels       ChatChannel[]
  notifications      Notification[]
  invites            Invitation[]
  customers          Customer[]
  taskTemplates      TaskTemplate[]
  marketingCampaigns MarketingCampaign[]
  marketingSegments  MarketingSegment[]
  marketingTemplates MarketingTemplate[]
  templates          Template[]

  // WMS (Anbar İdarəetmə Sistemi)
  warehouses     Warehouse[]
  products       Product[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]

  @@map("companies")
}

// =============================================================================
// MODEL: Department (Şöbə)
// =============================================================================

model Department {
  id          String   @id @default(cuid())
  name        String
  code        String? // Şöbə Kodu (Məsələn: IT-001)
  description String?
  color       String   @default("#6366f1") // Hex color for UI
  icon        String? // Lucide icon name
  orgLevel    OrgLevel @default(DEPARTMENT_HEAD)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // Sancılmış şöbə — silinə bilməz (yalnız Super Admin təyin edə bilər)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Tabeçilik — yuxarı şöbə (Müşahidə Şurası → İdarə Heyəti → Şöbə → Bölmə)
  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")

  // Şöbə rəhbəri (Head of Department)
  headUserId String?
  head       User?   @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)

  // Relations
  users         User[]
  projects      Project[]
  chatChannels  ChatChannel[]
  invites       Invitation[]
  taskTemplates TaskTemplate[]

  @@unique([companyId, name]) // Eyni şirkətdə eyni adlı şöbə olmaz
  @@index([parentId])
  @@map("departments")
}

// =============================================================================
// MODEL: Permission (İcazə — mərkəzi cədvəl)
// =============================================================================

model Permission {
  id          String        @id @default(cuid())
  key         PermissionKey @unique // Enum key: CAN_CREATE_PROJECT
  name        String // Human-readable: "Create Project"
  description String // Detailed description
  category    String // "PROJECT", "TASK", "COMPANY", etc.
  createdAt   DateTime      @default(now())

  // Relations
  rolePermissions RolePermission[]
  userGrants      UserPermission[]

  @@map("permissions")
}

// =============================================================================
// MODEL: UserPermission (Şöbə rəhbərinin fərdi istifadəçiyə əlavə verdiyi icazə)
// =============================================================================
// Rolun verdiyi icazələrdən əlavə, additiv şəkildə tətbiq olunur (rolu əvəz etmir).

model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  grantedById  String
  createdAt    DateTime @default(now())

  user       User       @relation("UserPermissionGrants", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User       @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// =============================================================================
// MODEL: Role (Dinamik Rol — şirkətə məxsus)
// =============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String // "Frontend Developer", "Project Manager", "CEO"
  description String?
  color       String   @default("#8b5cf6") // Hex color
  isDefault   Boolean  @default(false) // Yeni istifadəçiyə avtomatik verilən rol
  isSystem    Boolean  @default(false) // Sistem tərəfindən yaradılmış (silinə bilməz)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relations
  permissions RolePermission[]
  users       User[]
  invites     Invitation[]

  @@unique([companyId, name])
  @@map("roles")
}

// =============================================================================
// MODEL: RolePermission (Join table — Rol × İcazə)
// =============================================================================

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// MODEL: User (İstifadəçi)
// =============================================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  avatar       String? // URL
  passwordHash String // bcrypt hash
  status       UserStatus @default(ACTIVE)
  jobTitle     String? // "Senior Developer", "Product Manager"
  phone        String?
  address      String? // YENİ: Yaşayış/İş ünvanı
  bio          String? // YENİ: Haqqında qısa məlumat
  workingHours String     @default("09:00 - 18:00 (B.E - Cümə)") // YENİ: İş saatları

  // YENİ ƏLAVƏLƏR: Görünüş və Ayarlar
  theme     String @default("light") // "light", "dark", "system"
  language  String @default("az") // "az", "en", "ru"
  wallpaper String @default("default") // Rəng Teması (Color Theme): default | blue | purple | green | rose | orange | slate | zinc

  // YENİ: Kustomizasiya — səhifə üzrə vidjet/sütun görünürlüyü tərcihləri.
  // Format: { "<scopeKey>": { "<itemKey>": true|false } }, məsələn:
  // { "my-work-dashboard": { "upcomingEvents": true, "loggedTime": false } }
  preferences Json @default("{}")

  timezone    String    @default("Asia/Baku")
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Company membership
  companyId String?
  company   Company? @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: SetNull)

  // İstifadəçinin yaratdığı şirkət (1 istifadəçi = 1 şirkət sahibi)
  ownedCompany Company? @relation("CompanyOwner")

  // Department membership (nullable — hər istifadəçi şöbəyə aid olmaya bilər)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Təşkilati tabeçilik (birbaşa rəhbər)
  orgLevel    OrgLevel @default(SPECIALIST)
  isFounder   Boolean  @default(false) // Təsisçi — SUPER_ADMIN silə/yetkisini ala bilməz
  reportsToId String?
  reportsTo   User?    @relation("UserReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     User[]   @relation("UserReportsTo")

  // Role (company-specific)
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Relations
  projectMemberships        ProjectMember[]
  ownedProjects             Project[]           @relation("ProjectOwner")
  assignedTasks             Task[]              @relation("TaskAssignee")
  createdTasks              Task[]              @relation("TaskCreator")
  observedTasks             Task[]              @relation("TaskObservers")
  comments                  Comment[]
  attachments               Attachment[]
  auditLogs                 AuditLog[]
  assignedDeals             CrmDeal[]           @relation("CrmDealAssignee")
  channelMemberships        ChannelMember[]
  messagesSent              Message[]
  notifications             Notification[]
  invitesSent               Invitation[]        @relation("InviteSender")
  headOfDepartments         Department[]        @relation("DepartmentHead")
  callsInitiated            Call[]              @relation("CallCaller")
  callSignalsSent           CallSignal[]        @relation("CallSignalSender")
  extraPermissions          UserPermission[]    @relation("UserPermissionGrants")
  grantedUserPermissions    UserPermission[]    @relation("UserPermissionGrantedBy")
  marketingCampaignsCreated MarketingCampaign[] @relation("MarketingCampaignCreator")

  // WMS (Anbar İdarəetmə Sistemi)
  stockMovementsCreated StockMovement[] @relation("StockMovementCreator")
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreator")

  // Şablon (Template) sistemi
  templatesCreated          Template[]          @relation("TemplateCreator")
  marketingTemplatesCreated MarketingTemplate[] @relation("MarketingTemplateCreator")

  @@map("users")
}

// =============================================================================
// MODEL: Project (Layihə)
// =============================================================================

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  category    String? // "Software", "Marketing", "Research"
  color       String          @default("#3b82f6") // Hex
  coverImage  String? // URL
  startDate   DateTime?
  endDate     DateTime?
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Multi-tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Şöbəyə bağlı (ixtiyari)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Layihəni yaradan
  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  // Relations
  tasks        Task[]
  members      ProjectMember[]
  chatChannels ChatChannel[]

  @@map("projects")
}

// =============================================================================
// MODEL: ProjectMember (Join table — Layihə × İstifadəçi)
// =============================================================================

model ProjectMember {
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

// =============================================================================
// MODEL: Task (Tapşırıq + Subtask öz-özünə əlaqə)
// =============================================================================

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String? // Rich text (markdown supported)
  status         TaskStatus   @default(NOT_PLANNED)
  priority       TaskPriority @default(MEDIUM)
  position       Int          @default(0) // Kanban sıralama üçün
  dueDate        DateTime?
  startDate      DateTime?
  estimatedHours Float?
  actualHours    Float?
  completedAt    DateTime?
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Layihəyə bağlı
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // İcraçı (nullable — hənuz kimsəyə verilməmiş ola bilər)
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Müşahidəçilər (çox-çoxa — 1 assignee, çoxlu observer)
  observers User[] @relation("TaskObservers")

  // Yaradan
  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  // Subtask əlaqəsi (parent-child, özünə recursive)
  parentId String?
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskSubtasks")

  // Relations
  comments    Comment[]
  attachments Attachment[]
  labels      TaskLabel[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([parentId])
  @@index([status])
  @@map("tasks")
}

// =============================================================================
// MODEL: TaskTemplate (Tapşırıq şablonu)
// =============================================================================

model TaskTemplate {
  id           String      @id @default(cuid())
  name         String
  description  String?
  // YENİ: Strukturlaşdırılmış şablon məzmunu — { priority, estimatedHours, labelIds: [...], checklist: [...] }.
  // Şablondan tapşırıq yaradılarkən bu JSON klonlanır (dərin kopya) — Master şablon heç vaxt dəyişmir.
  data         Json        @default("{}")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Multi-tenant (şirkət sərhədi — şablonlar qarışmasın)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([departmentId])
  @@map("task_templates")
}

// =============================================================================
// MODEL: Template (Layihə / Dəvət / Rol-İcazə şablonları)
// =============================================================================
// Vahid "Master Template" sistemi: hər şablon bir dəfə yaradılır və redaktə
// oluna bilər, lakin şablon ƏSASINDA yeni element (layihə/dəvət/rol) yaradıldıqda
// `data` JSON-u sadəcə YENİ elementin öz sahələrinə KLONLANIR — heç bir
// birbaşa DB əlaqəsi saxlanmır. Bu səbəbdən yeni elementin sonrakı redaktəsi
// Master şablonu HEÇ VAXT zədələyə bilməz (referans deyil, tam surət).
model Template {
  id          String       @id @default(cuid())
  type        TemplateType
  name        String
  description String?
  // Növünə görə strukturu dəyişən "master" məzmun:
  //  PROJECT:    { status, priority, category, color, defaultTaskTitles: [...] }
  //  INVITATION: { inviteType, departmentId, roleId, message }
  //  ROLE:       { color, permissionKeys: [...] }
  data        Json         @default("{}")
  isSystem    Boolean      @default(false) // Standart quraşdırma ilə gələn "Default Template" — silinə bilməz, yalnız redaktə
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, type, name])
  @@index([companyId, type])
  @@map("templates")
}

// =============================================================================
// MODEL: Label (Etiket — şirkət səviyyəsində)
// =============================================================================

model Label {
  id        String   @id @default(cuid())
  name      String // "Bug", "Feature", "Urgent", "Backend"
  color     String   @default("#10b981") // Hex
  createdAt DateTime @default(now())

  // Multi-tenant
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relations
  taskLabels TaskLabel[]

  @@unique([companyId, name])
  @@map("labels")
}

// =============================================================================
// MODEL: TaskLabel (Join table — Task × Label)
// =============================================================================

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("task_labels")
}

// =============================================================================
// MODEL: Comment (Şərh)
// =============================================================================

model Comment {
  id               String   @id @default(cuid())
  content          String // Markdown text
  isEdited         Boolean  @default(false)
  mentionedUserIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Tapşırığa bağlı
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Müəllif
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Reply thread (öz-özünə əlaqə)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([parentId])
  @@map("comments")
}

// =============================================================================
// MODEL: Attachment (Fayl — UploadThing ilə cloud)
// =============================================================================

model Attachment {
  id           String   @id @default(cuid())
  fileName     String // Original file name
  fileUrl      String // UploadThing CDN URL
  fileKey      String   @unique // UploadThing file key (silmək üçün)
  fileType     String // MIME type: "image/png", "application/pdf"
  fileSize     Int // Bytes
  thumbnailUrl String? // Şəkillər üçün thumbnail URL
  createdAt    DateTime @default(now())

  // Tapşırığa bağlı
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Yükləyən
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("attachments")
}

// =============================================================================
// MODEL: AuditLog (Audit Jurnalı — kim nə etdi)
// =============================================================================

model AuditLog {
  id                String      @id @default(cuid())
  action            AuditAction
  entityType        EntityType
  entityId          String // Hansı entity-ə aid olduğu (project id, task id, etc.)
  entityName        String? // Human-readable entity adı (log üçün)
  metadata          Json? // Əlavə məlumat (before/after state, etc.)
  ipAddress         String?
  userAgent         String?
  sessionDurationMs Int? // LOGOUT zamanı sessiya müddəti (ms)
  createdAt         DateTime    @default(now())

  // Kim etdi
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Hansı şirkətin
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// CRM MODELS
// =============================================================================

model CrmCompany {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String // Multi-tenant company
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contacts CrmContact[]
  deals    CrmDeal[]

  @@index([companyId])
  @@map("crm_companies")
}

model CrmContact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  crmCompanyId String? // Associated with a B2B CRM Company
  crmCompany   CrmCompany? @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)

  deals CrmDeal[]

  @@index([companyId])
  @@map("crm_contacts")
}

model CrmStage {
  id        String   @id @default(cuid())
  name      String // e.g. "Yeni", "Danışıqlar", "Qazanıldı"
  color     String   @default("#94a3b8")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  deals CrmDeal[]

  @@unique([companyId, name])
  @@map("crm_stages")
}

model CrmDeal {
  id                String    @id @default(cuid())
  title             String
  value             Float     @default(0)
  currency          String    @default("AZN")
  probability       Int       @default(0) // 0-100%
  status            String    @default("OPEN") // OPEN, WON, LOST
  expectedCloseDate DateTime?
  deadline          DateTime?
  clientName        String?
  clientCompany     String?
  clientPhone       String?
  clientEmail       String?
  // Şifrəsiz, unikal müştəri izləmə linki üçün token (məsələn: /track/{trackingToken})
  trackingToken     String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stageId String
  stage   CrmStage @relation(fields: [stageId], references: [id])

  crmContactId String?
  crmContact   CrmContact? @relation(fields: [crmContactId], references: [id], onDelete: SetNull)

  crmCompanyId String?
  crmCompany   CrmCompany? @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("CrmDealAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Xarici inteqrasiyalar üçün (1C / Email / SMS / WhatsApp / Telegram) əlaqələndirilmiş müştəri
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  messageLogs MessageLog[]

  @@index([companyId])
  @@index([stageId])
  @@index([customerId])
  @@map("crm_deals")
}

// =============================================================================
// MODEL: Customer — Xarici sistemlərlə (1C, Email, WhatsApp, Telegram, SMS)
// inteqrasiya olunan real müştəri kartı.
// =============================================================================

model Customer {
  id             String   @id @default(cuid())
  name           String
  company        String?
  phone          String?
  email          String?
  source         String   @default("CRM") // "CRM", "1C", və s.
  external_1c_id String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Multi-tenant (deal yaradılarkən CRM tərəfindən doldurulur; 1C sinxronizasiyası
  // zamanı naməlum ola bilər)
  companyId String?
  tenant    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  deals       CrmDeal[]
  messageLogs MessageLog[]

  @@index([companyId])
  @@index([phone])
  @@index([email])
  @@map("customers")
}

// =============================================================================
// MODEL: MessageLog — Göndərilən hər Email/WhatsApp/Telegram/SMS mesajının
// real nəticəsinin (SENT/FAILED) jurnalı.
// =============================================================================

model MessageLog {
  id     String   @id @default(cuid())
  dealId String?
  deal   CrmDeal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  type         MessageLogType
  content      String
  status       MessageLogStatus
  errorMessage String?
  createdAt    DateTime         @default(now())

  @@index([dealId])
  @@index([customerId])
  @@index([createdAt])
  @@map("message_logs")
}

// =============================================================================
// MARKETİNQ MODELLƏRİ — Bitrix24 tərzi "Marketing" modulu
// Çoxkanallı (Email/SMS/WhatsApp/Instagram) kampaniyalar və auditoriya
// seqmentləri. Kanalların aktivliyi `src/lib/marketing-config.ts` tərəfindən
// .env-dəki API açarlarına əsasən dinamik müəyyən olunur.
// =============================================================================

model MarketingSegment {
  id   String @id @default(cuid())
  name String

  // Dinamik auditoriya filterləri (məs: { "source": "CRM", "hasEmail": true })
  filters Json @default("{}")

  // Mövcud Customer kartlarından seçilmiş ID-lər (Multi-select / Command palette)
  customerIds String[] @default([])

  // Statik siyahı (.csv / kopyala-yapışdır import) — [{ "name", "email", "phone" }]
  customRecipients Json @default("[]")

  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  campaigns MarketingCampaign[]

  @@index([companyId])
  @@map("marketing_segments")
}

model MarketingCampaign {
  id     String         @id @default(cuid())
  name   String
  type   CampaignType
  status CampaignStatus @default(DRAFT)

  subject String? // Email üçün mövzu sətri
  content String? // Text/HTML məzmun (email body / sms-whatsapp mətni / reklam mətni)

  // { "recipientCount", "sentCount", "failedCount", "openRate", "clickRate" }
  stats Json @default("{}")

  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  segmentId String?
  segment   MarketingSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("MarketingCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([segmentId])
  @@index([status])
  @@index([type])
  @@map("marketing_campaigns")
}

// Marketinq kampaniyaları üçün təkrar istifadə edilə bilən məzmun şablonları
// (Email/SMS/WhatsApp). Master şablon kampaniya yaradılarkən klonlanır.
model MarketingTemplate {
  id      String       @id @default(cuid())
  name    String
  type    CampaignType
  subject String?
  content String       @default("")

  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("MarketingTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([type])
  @@map("marketing_templates")
}

// =============================================================================
// CHAT MODELS
// =============================================================================

enum ChatChannelType {
  DIRECT
  PROJECT
  DEPARTMENT
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

enum CallType {
  AUDIO
  VIDEO
}

model ChatChannel {
  id          String          @id @default(cuid())
  name        String?
  type        ChatChannelType
  description String? // Qrup "Haqqında / Bio"
  avatar      String? // Qrup şəkli (URL)
  adminsOnly  Boolean         @default(false) // true: yalnız inzibatçılar mesaj göndərə bilər
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  members  ChannelMember[]
  messages Message[]
  calls    Call[]

  @@index([companyId])
  @@map("chat_channels")
}

model ChannelMember {
  id         String   @id @default(cuid())
  channelId  String
  userId     String
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_members")
}

model Message {
  id        String    @id @default(cuid())
  content   String?
  fileUrl   String?
  fileName  String?
  fileType  String?
  isPinned  Boolean   @default(false)
  pinExpiry DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([channelId, isPinned])
  @@map("messages")
}

// =============================================================================
// MODEL: Call / CallSignal (WebRTC signaling — polling-based, no socket server)
// =============================================================================

model Call {
  id        String     @id @default(cuid())
  type      CallType   @default(VIDEO)
  status    CallStatus @default(RINGING)
  startedAt DateTime   @default(now())
  endedAt   DateTime?

  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  callerId String
  caller   User   @relation("CallCaller", fields: [callerId], references: [id])

  signals CallSignal[]

  @@index([channelId])
  @@map("calls")
}

model CallSignal {
  id        String   @id @default(cuid())
  type      String // offer | answer | ice-candidate | hangup | decline
  payload   Json
  createdAt DateTime @default(now())

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("CallSignalSender", fields: [senderId], references: [id])

  @@index([callId, createdAt])
  @@map("call_signals")
}

// =============================================================================
// MODEL: Notification
// =============================================================================

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  MENTION
  COMMENT_REPLY
  COMMENT_ADDED
  INVITE
  DEADLINE_APPROACHING
  CALL_INCOMING
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([companyId])
  @@map("notifications")
}

// =============================================================================
// MODEL: Invitation (Ağıllı Dəvət — token-based onboarding)
// Cədvəl adı `invites` saxlanılır ki, mövcud data və arxitektura zədələnməsin.
// =============================================================================

enum InviteType {
  MEMBER
  GUEST
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id         String       @id @default(cuid())
  email      String
  name       String?
  surname    String?
  message    String?
  token      String       @unique
  type       InviteType   @default(MEMBER)
  status     InviteStatus @default(PENDING)
  projectIds String[]     @default([]) // GUEST invites: restricted project scope
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  invitedById String
  invitedBy   User   @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([companyId])
  @@index([email])
  @@map("invites")
}

// =============================================================================
// WMS MODELLƏRİ — Anbar İdarəetmə Sistemi (Bitrix24 / Odoo / SAP tərzi)
// Multi-tenant (companyId), tam iyerarxiya: Warehouse → Zone → Bin.
// Bütün stok hərəkətləri StockMovement üzərindən $transaction ilə tətbiq
// olunur və nəticə InventoryLevel-də real-time əks olunur.
// =============================================================================

model Warehouse {
  id        String        @id @default(cuid())
  name      String
  location  String?
  type      WarehouseType @default(MAIN)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  zones           WarehouseZone[]
  inventoryLevels InventoryLevel[]
  purchaseOrders  PurchaseOrder[]

  movementsFrom StockMovement[] @relation("MovementFromWarehouse")
  movementsTo   StockMovement[] @relation("MovementToWarehouse")

  @@unique([companyId, name])
  @@index([companyId])
  @@map("warehouses")
}

model WarehouseZone {
  id        String   @id @default(cuid())
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  bins WarehouseBin[]

  @@unique([warehouseId, name])
  @@index([warehouseId])
  @@map("warehouse_zones")
}

model WarehouseBin {
  id        String   @id @default(cuid())
  code      String // Rack/Bin kodu, məsələn: "A-01-03"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zoneId String
  zone   WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  inventoryLevels InventoryLevel[]

  movementsFromBin StockMovement[] @relation("MovementFromBin")
  movementsToBin   StockMovement[] @relation("MovementToBin")

  @@unique([zoneId, code])
  @@index([zoneId])
  @@map("warehouse_bins")
}

model Product {
  id               String   @id @default(cuid())
  sku              String
  barcode          String?
  name             String
  category         String?
  unit             String   @default("pcs") // pcs, kg, m, l, box...
  minStockLimit    Float    @default(0)
  purchasePrice    Float    @default(0) // Default alış qiyməti (sənəd səviyyəsində əvəz oluna bilər)
  salesPrice       Float    @default(0) // Default satış qiyməti
  isTrackedByBatch Boolean  @default(false) // Partiya/Lot və son istifadə tarixi ilə izlənilir
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventoryLevels    InventoryLevel[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([barcode])
  @@index([category])
  @@map("products")
}

model InventoryLevel {
  id         String    @id @default(cuid())
  quantity   Float     @default(0)
  lotNumber  String?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  binId String?
  bin   WarehouseBin? @relation(fields: [binId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId, binId, lotNumber])
  @@index([productId])
  @@index([warehouseId])
  @@index([binId])
  @@map("inventory_levels")
}

model StockMovement {
  id          String              @id @default(cuid())
  type        StockMovementType
  status      StockMovementStatus @default(DRAFT)
  reference   String? // Sənəd adı/nömrəsi, məsələn: "Stock adjustment #1"
  comment     String?
  currency    String              @default("AZN")
  quantity    Float
  unitCost    Float               @default(0) // Purchase price (sətir səviyyəsində)
  unitPrice   Float               @default(0) // Sales price (sətir səviyyəsində)
  totalAmount Float               @default(0) // unitCost * quantity
  lotNumber   String?
  expiryDate  DateTime?
  processedAt DateTime? // COMPLETED statusuna keçdiyi an (qalıqlara tətbiq olunduğu vaxt)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouseId String?
  toWarehouse   Warehouse? @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])

  fromBinId String?
  fromBin   WarehouseBin? @relation("MovementFromBin", fields: [fromBinId], references: [id])

  toBinId String?
  toBin   WarehouseBin? @relation("MovementToBin", fields: [toBinId], references: [id])

  // YENİ: Təchizatçı — INBOUND (qəbul) sənədləri üçün mənbə təchizatçı
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("StockMovementCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([productId])
  @@index([type])
  @@index([supplierId])
  @@index([status])
  @@index([reference])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  taxId       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  orderNumber String
  status      PurchaseOrderStatus @default(DRAFT)
  currency    String              @default("AZN")
  totalAmount Float               @default(0)
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("PurchaseOrderCreator", fields: [createdById], references: [id])

  items PurchaseOrderItem[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id          String @id @default(cuid())
  quantity    Float
  receivedQty Float  @default(0)
  unitCost    Float  @default(0)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}
